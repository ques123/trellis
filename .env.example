# Postgres connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/trellis

# Port the server listens on
PORT=3000

# The single email address allowed to sign in (required)
ALLOWED_EMAIL=adam@example.com

# Password login: generate with  node scripts/hash-password.js 'your password'
AUTH_PASSWORD_HASH=

# Magic-link login via Resend (optional — without it the link is printed to the server log)
RESEND_API_KEY=
RESEND_FROM=login@yourdomain.com

# Bearer tokens for the agent API (/api/trellis/agent). Leave unset to disable it.
TRELLIS_AGENT_TOKEN=
TRELLIS_AGENT_TOKEN_CODEX=
